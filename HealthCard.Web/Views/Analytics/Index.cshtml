@model AnalyticsViewModel
@{ViewData["Title"]="Аналитика";var unit=Model.Series.FirstOrDefault()?.Unit??"";}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><h1 class="h3 mb-2">Аналитика анализов</h1><p class="text-muted mb-0">История показателей и сравнение с вашими референсными интервалами</p></div>
@if(Model.Results.Count>0){<div class="d-flex gap-2"><a asp-action="Export" asp-route-format="csv" asp-route-categoryId="@Model.CategoryId" asp-route-parameterId="@Model.ParameterId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Скачать CSV</a><a asp-action="Export" asp-route-format="pdf" asp-route-categoryId="@Model.CategoryId" asp-route-parameterId="@Model.ParameterId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-primary">Скачать PDF</a></div>}</div>
<form method="get" id="analytics-filter" class="card card-body mb-4"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3 align-items-end"><div class="col-lg-3"><label for="analytics-category" class="form-label">Категория</label><select asp-for="CategoryId" class="form-select" id="analytics-category">@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-lg-3"><label for="analytics-parameter" class="form-label">Показатель</label><select asp-for="ParameterId" class="form-select" id="analytics-parameter">@foreach(var p in Model.Parameters){<option value="@p.Id">@p.Name</option>}</select></div><div class="col-sm-6 col-lg-2"><label asp-for="FromDate" class="form-label">С даты</label><input asp-for="FromDate" type="date" class="form-control" /></div><div class="col-sm-6 col-lg-2"><label asp-for="ToDate" class="form-label">По дату</label><input asp-for="ToDate" type="date" class="form-control" /></div><div class="col-lg-2 d-flex gap-2"><button type="submit" class="btn btn-primary">Показать</button><a asp-action="Index" class="btn btn-outline-secondary">Сброс</a></div></div></form>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card card-body h-100"><div class="text-muted small">Записей в категории за период</div><strong class="fs-2">@Model.TotalRecords</strong></div></div><div class="col-6 col-lg-3"><div class="card card-body h-100"><div class="text-muted small">Измерений показателя</div><strong class="fs-2">@Model.Results.Count</strong></div></div><div class="col-6 col-lg-3"><div class="card card-body h-100"><div class="text-muted small">Вне интервала</div><strong class="fs-2 text-danger">@Model.OutOfRangeCount</strong></div></div><div class="col-6 col-lg-3"><div class="card card-body h-100"><div class="text-muted small">У границ интервала</div><strong class="fs-2 text-warning-emphasis">@Model.NearBoundaryCount</strong></div></div></div>
@if(Model.Series.Count>0){<section class="card mb-4"><div class="card-body p-4"><h2 class="h5">@Model.Series[0].ParameterName <small class="text-muted">@unit</small></h2><p class="small text-muted">Интервал: @Model.Series[0].NormMin.ToString("0.####") – @Model.Series[0].NormMax.ToString("0.####") @(Model.Series[0].IsCustomNorm?"· персональный":"· общий")</p>
<div class="trend-chart"><canvas id="trend-chart" role="img" aria-label="График изменения выбранного показателя. Точные значения приведены в таблице ниже." data-series="@JsonSerializer.Serialize(Model.Series.Select(r=>new{date=r.Date.ToString("dd.MM.yyyy"),value=r.Value,min=r.NormMin,max=r.NormMax,status=r.StatusText,recordId=r.RecordId}))"></canvas></div><p id="chart-point" class="small text-muted mt-2" aria-live="polite">Наведите указатель на точку, чтобы увидеть значение. Зеленая область — заданный интервал.</p>
<div class="d-flex flex-wrap gap-4 border-top pt-3"><span>Минимум: <strong>@Model.Minimum?.ToString("0.####")</strong></span><span>Среднее: <strong>@Model.Average?.ToString("0.####")</strong></span><span>Максимум: <strong>@Model.Maximum?.ToString("0.####")</strong></span><span>Изменение от первого: <strong>@(Model.Change?.ToString("+0.####;-0.####;0")??"недостаточно данных")</strong> @unit</span></div></div></section>
<section class="card"><div class="card-header"><strong>История измерений</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Дата</th><th>Запись</th><th>Значение</th><th>Интервал</th><th>Статус</th></tr></thead><tbody>@foreach(var r in Model.Results.OrderByDescending(r=>r.Date).ThenByDescending(r=>r.RecordId).Take(200)){<tr><td class="text-nowrap">@r.Date.ToString("dd.MM.yyyy")</td><td><a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@r.RecordId">@r.Title</a></td><td><strong>@r.Value.ToString("0.####")</strong> @r.Unit</td><td>@r.NormMin.ToString("0.####") – @r.NormMax.ToString("0.####")</td><td><span class="badge text-bg-@r.CssClass">@r.StatusText</span></td></tr>}</tbody></table></div></section>
@if(Model.Results.Count>200){<p class="small text-muted mt-2">На странице последние 200 измерений. Экспорт включает все результаты выбранного фильтра.</p>}
<p class="small text-muted mt-3">Статистика описывает сохраненные значения и не является медицинским заключением.</p>
}else{<div class="empty-state"><h2 class="h5">Нет измерений для выбранных условий</h2><p class="text-muted">Выберите другой показатель, измените даты или добавьте новый анализ.</p><a asp-controller="MedicalRecord" asp-action="Create" asp-route-categoryId="@Model.CategoryId" class="btn btn-primary">Добавить анализ</a></div>}
