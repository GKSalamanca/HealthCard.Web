<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Карточка здоровья</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-xl navbar-dark bg-primary">
<div class="container">
    <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-heart-pulse"></i> Карточка здоровья</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Открыть меню"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNavigation">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Главная</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="MedicalRecord" asp-action="Index">Мои записи</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="MedicalRecord" asp-action="Create">Добавить запись</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Category" asp-action="Index">Категории</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="Index">Аналитика</a></li>
            </ul>
            <ul class="navbar-nav"><li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle"></i> Аккаунт</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Мой профиль</a></li>
                    <li><a class="dropdown-item" asp-controller="Norms" asp-action="Index">Персональные нормы</a></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Изменить пароль</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item">Выйти</button></form></li>
                </ul>
            </li></ul>
        }
        else { <a class="nav-link text-white ms-auto" asp-controller="Account" asp-action="Login">Войти</a> }
    </div>
</div>
</nav>
</header>
<main class="container py-4" id="main-content">
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="py-3 border-top text-center text-muted"><small>Карточка здоровья · Личный медицинский архив</small></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)
</body>
</html>
