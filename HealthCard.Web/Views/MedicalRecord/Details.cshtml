@model RecordDetailsViewModel
@{ ViewData["Title"]=Model.Record.Title; }
<div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h1 class="h3">@Model.Record.Title</h1><p class="text-muted mb-0">@Model.Record.RecordDate.ToString("dd.MM.yyyy") · <a asp-controller="CategoryRecords" asp-action="Details" asp-route-id="@Model.Record.CategoryId">@Model.Record.Category.Name</a></p></div><a asp-action="Edit" asp-route-id="@Model.Record.Id" class="btn btn-primary align-self-start">Редактировать</a></div>
@if(!string.IsNullOrWhiteSpace(Model.Record.Comment)){<div class="card mb-4"><div class="card-body"><h2 class="h5">Комментарий</h2><p class="mb-0 preserve-lines">@Model.Record.Comment</p></div></div>}
@if(Model.Results.Count>0){
<div class="card mb-4"><div class="card-header d-flex justify-content-between flex-wrap gap-2"><strong>Результаты анализа</strong><a asp-controller="Norms" asp-action="Index" asp-route-categoryId="@Model.Record.CategoryId">Настроить мои интервалы</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Показатель</th><th>Результат</th><th>Единица</th><th>Интервал</th><th>Статус</th></tr></thead><tbody>
@foreach(var result in Model.Results){<tr class="table-@result.CssClass"><td><a asp-controller="Analytics" asp-action="Index" asp-route-categoryId="@result.CategoryId" asp-route-parameterId="@result.ParameterId">@result.ParameterName</a></td><td><strong>@result.Value.ToString("0.####")</strong></td><td>@result.Unit</td><td>@result.NormMin.ToString("0.####") – @result.NormMax.ToString("0.####") @(result.IsCustomNorm?"(мой)":"")</td><td>@result.StatusText</td></tr>}
</tbody></table></div></div><p class="small text-muted">Статус отражает сравнение с заданным интервалом и не является диагнозом.</p>
}else if(Model.Record.Category.IsLabTest){<p class="text-muted">Числовые результаты не заполнены. Их можно добавить при редактировании.</p>}
@if(Model.Record.FilePath!=null){<div class="card mb-4"><div class="card-body"><h2 class="h5">Прикрепленный документ</h2><a asp-action="Download" asp-route-id="@Model.Record.Id" class="btn btn-outline-primary">Скачать вложение</a></div></div>}
<div class="d-flex flex-wrap gap-2"><a asp-action="Index" class="btn btn-outline-secondary">К списку записей</a><a asp-controller="CategoryRecords" asp-action="Details" asp-route-id="@Model.Record.CategoryId" class="btn btn-outline-primary">История категории</a><a asp-action="Delete" asp-route-id="@Model.Record.Id" class="btn btn-outline-danger">Удалить запись</a></div>
