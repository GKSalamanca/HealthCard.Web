@{
    ViewData["Title"] = "Детали записи";
    var record = ViewBag.Record as Models.ParameterBase.MedicalRecord;
    var results = ViewBag.Results as List<dynamic>;
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Мои записи</a></li>
                <li class="breadcrumb-item active">@record.Title</li>
            </ol>
        </nav>
        <h2>@record.Title</h2>
        <p class="text-muted">
            <i class="bi bi-calendar"></i> @record.RecordDate.ToString("dd.MM.yyyy") |
            <span class="badge bg-secondary">@record.Category.Name</span>
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(record.Comment))
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-chat-left-text"></i> Комментарий</h5>
        </div>
        <div class="card-body">
            <p class="mb-0">@record.Comment</p>
        </div>
    </div>
}

@if (results != null && results.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-clipboard-data"></i> Результаты анализа</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Параметр</th>
                            <th>Норма</th>
                            <th>Ед. изм.</th>
                            <th>Ваш результат</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in results)
                        {
                            <tr class="@(result.IsOutOfRange ? "table-danger" : (result.IsNearOutOfRange ? "table-warning" : "table-success"))">
                                <td>@result.ParameterName</td>
                                <td>@result.NormMin – @result.NormMax</td>
                                <td>@result.Unit</td>
                                <td><strong>@result.Value</strong></td>
                                <td>
                                    @if (result.IsOutOfRange)
                                    {
                                        <span class="badge bg-danger">Вне нормы</span>
                                    }
                                    else if (result.IsNearOutOfRange)
                                    {
                                        <span class="badge bg-warning text-dark">Пограничное</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Норма</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(record.FilePath))
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-paperclip"></i> Прикрепленный файл</h5>
        </div>
        <div class="card-body">
            <a href="/@record.FilePath" target="_blank" class="btn btn-outline-primary">
                <i class="bi bi-download"></i> Скачать файл
            </a>
        </div>
    </div>
}

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
    <a asp-action="Delete" asp-route-id="@record.Id" class="btn btn-danger">
        <i class="bi bi-trash"></i> Удалить запись
    </a>
</div>