@model RecordCreateViewModel
@{ var editing=Model.Id>0; ViewData["Title"]=editing?"Редактировать запись":"Добавить запись"; }
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4"><h1 class="h3 mb-0">@ViewData["Title"]</h1><a asp-controller="Category" asp-action="Create" class="btn btn-outline-primary">Создать свою категорию</a></div>
<div class="card"><div class="card-body p-4">
<form asp-action="@(editing?"Edit":"Create")" asp-route-id="@(editing?Model.Id:(int?)null)" method="post" enctype="multipart/form-data" id="record-form">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="CategoryId" class="form-label">Категория</label>
@if(editing) { <input asp-for="CategoryId" type="hidden" /><input class="form-control" value="@Model.Categories.FirstOrDefault(c=>c.Id==Model.CategoryId)?.Name" readonly /> }
else { <select asp-for="CategoryId" class="form-select" data-parameters-url="@Url.Action("Parameters")"><option value="">Выберите категорию</option>@foreach(var category in Model.Categories){<option value="@category.Id">@category.Name</option>}</select> }
<span asp-validation-for="CategoryId" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="RecordDate" class="form-label">Дата исследования</label><input asp-for="RecordDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /><span asp-validation-for="RecordDate" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Title" class="form-label">Название записи</label><input asp-for="Title" class="form-control" placeholder="Например, липидный профиль в лаборатории" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Comment" class="form-label">Комментарий</label><textarea asp-for="Comment" class="form-control" rows="3"></textarea><span asp-validation-for="Comment" class="text-danger"></span></div>
</div>
<div id="parameters-container" aria-live="polite"><partial name="_Parameters" model="Model" /></div>
<div class="mt-4"><label asp-for="File" class="form-label">Прикрепить PDF или изображение</label><input asp-for="File" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control" /><div class="form-text">PDF, JPG, PNG. Размер до 10 МБ.</div><span asp-validation-for="File" class="text-danger"></span></div>
@if(Model.ExistingFilePath!=null){<div class="mt-3"><a asp-action="Download" asp-route-id="@Model.Id">Скачать текущее вложение</a><div class="form-check mt-2"><input asp-for="RemoveFile" class="form-check-input" /><label asp-for="RemoveFile" class="form-check-label">Удалить текущее вложение</label></div></div>}
<div class="d-flex gap-2 justify-content-end mt-4"><a asp-action="@(editing?"Details":"Index")" asp-route-id="@(editing?Model.Id:(int?)null)" class="btn btn-outline-secondary">Отмена</a><button class="btn btn-primary" type="submit" id="save-record">Сохранить запись</button></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
