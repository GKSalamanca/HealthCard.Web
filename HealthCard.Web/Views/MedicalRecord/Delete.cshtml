@model Models.ParameterBase.MedicalRecord
@{
    ViewData["Title"] = "Удаление записи";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Подтверждение удаления</h4>
            </div>
            <div class="card-body">
                <p class="mb-3">Вы уверены, что хотите удалить эту запись?</p>
                
                <div class="alert alert-light">
                    <h5>@Model.Title</h5>
                    <p class="mb-1"><strong>Категория:</strong> @Model.Category.Name</p>
                    <p class="mb-1"><strong>Дата:</strong> @Model.RecordDate.ToString("dd.MM.yyyy")</p>
                    @if (!string.IsNullOrEmpty(Model.Comment))
                    {
                        <p class="mb-0"><strong>Комментарий:</strong> @Model.Comment</p>
                    }
                </div>

                <p class="text-danger">
                    <i class="bi bi-info-circle"></i> Это действие нельзя отменить. Все связанные результаты анализов будут удалены.
                </p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg"></i> Отмена
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Удалить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>