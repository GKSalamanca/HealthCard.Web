@model RecordListViewModel
@{ViewData["Title"]="Мои записи";}
<div class="d-flex justify-content-between flex-wrap gap-2 mb-4"><div><h1 class="h3">Мои записи</h1><span class="text-muted">Найдено: @Model.TotalCount</span></div><a asp-action="Create" class="btn btn-primary align-self-start">Добавить запись</a></div>
<form method="get" class="card card-body mb-4"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3 align-items-end">
<div class="col-md-4"><label asp-for="CategoryId" class="form-label">Категория</label><select asp-for="CategoryId" class="form-select"><option value="">Все категории</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></div>
<div class="col-md-3"><label asp-for="FromDate" class="form-label">С даты</label><input asp-for="FromDate" type="date" class="form-control" /></div><div class="col-md-3"><label asp-for="ToDate" class="form-label">По дату</label><input asp-for="ToDate" type="date" class="form-control" /></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-primary" type="submit">Найти</button><a asp-action="Index" class="btn btn-outline-secondary">Сброс</a></div></div></form>
@if(Model.Records.Count==0){<div class="empty-state"><h2 class="h5">Записей пока нет</h2><p class="text-muted">Добавьте первое исследование или измените фильтры.</p><a asp-action="Create" class="btn btn-primary">Добавить запись</a></div>}
else{<div class="row g-3">@foreach(var record in Model.Records){<div class="col-md-6"><article class="card h-100"><div class="card-body"><span class="badge text-bg-light mb-2">@record.Category.Name</span><h2 class="h5">@record.Title</h2><p class="text-muted">@record.RecordDate.ToString("dd.MM.yyyy") @(record.FilePath!=null?"· С вложением":"")</p>@if(record.Comment!=null){<p class="record-excerpt">@record.Comment</p>}</div><div class="card-footer bg-white d-flex flex-wrap gap-2"><a asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">Открыть</a><a asp-action="Edit" asp-route-id="@record.Id" class="btn btn-sm btn-outline-secondary">Изменить</a><a asp-action="Delete" asp-route-id="@record.Id" class="btn btn-sm btn-outline-danger ms-auto">Удалить</a></div></article></div>}</div>}
@if(Model.TotalPages>1){<nav class="d-flex gap-3 align-items-center mt-4" aria-label="Страницы записей">@if(Model.Page>1){<a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-categoryId="@Model.CategoryId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Предыдущая</a>}<span>@Model.Page / @Model.TotalPages</span>@if(Model.Page<Model.TotalPages){<a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-categoryId="@Model.CategoryId" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Следующая</a>}</nav>}
