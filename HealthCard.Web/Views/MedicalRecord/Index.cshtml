@model List<Models.ParameterBase.MedicalRecord>
@{
    ViewData["Title"] = "Мои записи";
    var categories = ViewBag.Categories as List<Models.ParameterBase.Category>;
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-file-earmark-medical"></i> Мои записи</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить запись
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Категория</label>
                <select name="categoryId" class="form-select">
                    <option value="">Все категории</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(ViewContext.HttpContext.Request.Query["categoryId"] == cat.Id.ToString())">
                            @cat.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">С даты</label>
                <input type="date" name="fromDate" class="form-control" 
                       value="@ViewContext.HttpContext.Request.Query["fromDate"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label">По дату</label>
                <input type="date" name="toDate" class="form-control" 
                       value="@ViewContext.HttpContext.Request.Query["toDate"]" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel"></i> Фильтр
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var record in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@record.Title</h5>
                            <span class="badge bg-secondary">@record.Category.Name</span>
                        </div>
                        <p class="text-muted mb-2">
                            <i class="bi bi-calendar"></i> @record.RecordDate.ToString("dd.MM.yyyy")
                        </p>
                        @if (!string.IsNullOrEmpty(record.Comment))
                        {
                            <p class="card-text">@record.Comment</p>
                        }
                        @if (!string.IsNullOrEmpty(record.FilePath))
                        {
                            <p class="mb-2">
                                <i class="bi bi-paperclip"></i> Файл прикреплен
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Подробнее
                            </a>
                            <a asp-action="Delete" asp-route-id="@record.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <p class="mt-3 text-muted">У вас пока нет записей</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить первую запись
        </a>
    </div>
}