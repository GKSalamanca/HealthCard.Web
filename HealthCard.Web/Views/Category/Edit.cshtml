@model CategoryEditViewModel
@{var editing=Model.Id>0;ViewData["Title"]=editing?"Изменить категорию":"Моя новая категория";}
<h1 class="h3 mb-2">@ViewData["Title"]</h1><p class="text-muted mb-4">Создайте собственный анализ с показателями или категорию для документов.</p>
<form asp-action="@(editing?"Edit":"Create")" asp-route-id="@(editing?Model.Id:(int?)null)" method="post" class="card card-body p-4" id="category-form">
<input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label">Название категории</label><input asp-for="Name" class="form-control" placeholder="Например, витамины и микроэлементы" /></div><div class="col-md-4"><label for="category-type" class="form-label">Тип</label>@if(editing){<input asp-for="IsLabTest" type="hidden" /><input id="category-type" class="form-control" readonly value="@(Model.IsLabTest?"Лабораторный анализ":"Исследование или документ")" />}else{<select asp-for="IsLabTest" class="form-select" id="category-type"><option value="true">Лабораторный анализ</option><option value="false">Исследование или документ</option></select>}</div><div class="col-12"><label asp-for="Description" class="form-label">Описание</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div></div>
<section id="category-parameters" class="mt-4" hidden="@(!Model.IsLabTest)"><div class="d-flex justify-content-between flex-wrap gap-2 mb-2"><h2 class="h5 mb-0">Показатели анализа</h2><button type="button" class="btn btn-sm btn-outline-primary" id="add-parameter">Добавить показатель</button></div><p class="small text-muted">Укажите название, единицу и референсный интервал. Используемые в записях показатели удалять нельзя.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Название</th><th>Единица</th><th>Нижняя граница</th><th>Верхняя граница</th><th>Удалить</th></tr></thead><tbody id="parameter-rows">
@for(var i=0;i<Model.Parameters.Count;i++){<tr data-parameter-row><td><input asp-for="Parameters[i].Id" type="hidden" data-field="Id" /><input asp-for="Parameters[i].Name" class="form-control" data-field="Name" aria-label="Название показателя" /></td><td><input asp-for="Parameters[i].Unit" class="form-control" data-field="Unit" aria-label="Единица измерения" /></td><td><input asp-for="Parameters[i].NormMin" type="number" step="0.0001" min="0" max="99999999" class="form-control" data-field="NormMin" aria-label="Нижняя граница" /></td><td><input asp-for="Parameters[i].NormMax" type="number" step="0.0001" min="0" max="99999999" class="form-control" data-field="NormMax" aria-label="Верхняя граница" /></td><td>@if(Model.Parameters[i].Id>0){<input type="checkbox" name="Parameters[@i].Remove" value="true" checked="@Model.Parameters[i].Remove" class="form-check-input" data-field="Remove" aria-label="Удалить показатель" />}else{<button class="btn btn-sm btn-outline-danger" type="button" data-remove-row>Убрать</button>}</td></tr>}
</tbody></table></div></section>
<template id="parameter-template"><tr data-parameter-row><td><input type="hidden" value="0" data-field="Id" /><input class="form-control" data-field="Name" maxlength="200" aria-label="Название показателя" /></td><td><input class="form-control" data-field="Unit" maxlength="50" aria-label="Единица измерения" /></td><td><input type="number" value="0" step="0.0001" min="0" max="99999999" class="form-control" data-field="NormMin" aria-label="Нижняя граница" /></td><td><input type="number" value="0" step="0.0001" min="0" max="99999999" class="form-control" data-field="NormMax" aria-label="Верхняя граница" /></td><td><button class="btn btn-sm btn-outline-danger" type="button" data-remove-row>Убрать</button></td></tr></template>
<div class="d-flex flex-wrap gap-2 justify-content-end mt-4">@if(editing){<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger me-auto">Удалить категорию</a>}<a asp-action="Index" class="btn btn-outline-secondary">Отмена</a><button type="submit" class="btn btn-primary">Сохранить категорию</button></div>
</form>
