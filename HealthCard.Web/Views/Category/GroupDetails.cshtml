@model List<HealthCard.Web.ViewModels.CategoryStatsViewModel>
@{
    var isLabTest = ViewBag.IsLabTest as bool? ?? false;
    var title = ViewBag.Title as string ?? "Категории";
    ViewData["Title"] = title;
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
        <h2>
            <i class="bi @(isLabTest ? "bi-droplet-fill text-primary" : "bi-folder2-open text-success")"></i>
            @title
        </h2>
        <p class="text-muted">
            @(isLabTest ? "Лабораторные анализы" : "Исследования и заключения")
        </p>
    </div>
</div>

<div class="row">
    @foreach (var category in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <h5 class="card-title mb-1">
                                <i class="bi bi-folder-fill text-primary"></i>
                                @category.CategoryName
                            </h5>
                            @if (category.Description != null)
                            {
                                <small class="text-muted">@category.Description</small>
                            }
                        </div>
                        @if (isLabTest)
                        {
                            <span class="badge bg-primary ms-2">Анализ</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-2">Исследование</span>
                        }
                    </div>

                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">
                                <i class="bi bi-file-earmark-medical"></i>
                                Записей: <strong>@category.RecordsCount</strong>
                            </small>
                            @if (category.LastRecordDate.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i>
                                    @category.LastRecordDate.Value.ToString("dd.MM.yyyy")
                                </small>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="MedicalRecord" asp-action="Create"
                               asp-route-categoryId="@category.CategoryId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-plus-lg"></i> Добавить
                            </a>
                            <a asp-controller="CategoryRecords" asp-action="Details"
                               asp-route-id="@category.CategoryId"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye"></i> Смотреть
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад на главную
    </a>
</div>