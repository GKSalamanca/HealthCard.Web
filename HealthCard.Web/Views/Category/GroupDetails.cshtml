@model List<CategoryStatsViewModel>
@{ViewData["Title"]=ViewBag.Title??"Категории";}
<div class="d-flex justify-content-between flex-wrap gap-2 mb-4"><div><h1 class="h3">@ViewData["Title"]</h1><p class="text-muted mb-0">Базовые исследования и ваши собственные категории</p></div><a asp-action="Create" class="btn btn-primary align-self-start">Создать свою категорию</a></div>
<div class="d-flex flex-wrap gap-2 mb-4"><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Все</a><a asp-action="GroupDetails" asp-route-type="LabTest" class="btn btn-sm btn-outline-secondary">Лабораторные анализы</a><a asp-action="GroupDetails" asp-route-type="Research" class="btn btn-sm btn-outline-secondary">Исследования и заключения</a></div>
<div class="row g-3">@foreach(var c in Model){<div class="col-md-6 col-lg-4"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between mb-3"><i class="@(c.IsLabTest?"bi bi-droplet":"bi bi-folder2-open") fs-3 text-primary"></i><span class="badge text-bg-light align-self-start">@(c.IsSystem?"Базовая":"Моя категория")</span></div><h2 class="h5">@c.CategoryName</h2><p class="text-muted">@c.Description</p><p class="small">Записей: <strong>@c.RecordsCount</strong><br />Последняя: @(c.LastRecordDate?.ToString("dd.MM.yyyy")??"пока нет")</p></div><div class="card-footer bg-white d-flex flex-wrap gap-2"><a asp-controller="MedicalRecord" asp-action="Create" asp-route-categoryId="@c.CategoryId" class="btn btn-sm btn-primary">Добавить запись</a><a asp-controller="CategoryRecords" asp-action="Details" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary">История</a>@if(!c.IsSystem){<a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-secondary">Изменить</a>}</div></article></div>}</div>
@if(Model.Count==0){<div class="empty-state"><p>В этой группе пока нет категорий.</p><a asp-action="Create" class="btn btn-primary">Создать категорию</a></div>}
