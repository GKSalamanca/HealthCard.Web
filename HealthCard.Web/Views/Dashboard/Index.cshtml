@model HealthCard.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Главная";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-heart-pulse-fill text-danger"></i> Добро пожаловать, @Model.UserName!</h2>
        <p class="text-muted">Ваша персональная карточка здоровья</p>
    </div>
</div>

<!-- Карточки со статистикой -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Всего записей</h5>
                <p class="card-text display-6">@Model.TotalRecordsCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Доступно анализов</h5>
                <p class="card-text display-6">@Model.Categories.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Статус</h5>
                <p class="card-text fs-4">Система активна</p>
            </div>
        </div>
    </div>
</div>

<!-- Папочки категорий -->
<div class="row mb-4">
    <div class="col-12">
        <h4 class="mb-3"><i class="bi bi-folder2-open"></i> Виды исследований</h4>
    </div>
</div>

<div class="row">
    @foreach (var stat in Model.CategoryStatistics)
    {
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <h5 class="card-title mb-1">
                                <i class="bi bi-folder-fill text-primary"></i>
                                @stat.CategoryName
                            </h5>
                            @if (stat.Description != null)
                            {
                                <small class="text-muted">@stat.Description</small>
                            }
                        </div>
                        @if (stat.IsLabTest)
                        {
                            <span class="badge bg-primary ms-2">Анализ</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-2">Исследование</span>
                        }
                    </div>
                    
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">
                                <i class="bi bi-file-earmark-medical"></i> 
                                Записей: <strong>@stat.RecordsCount</strong>
                            </small>
                            @if (stat.LastRecordDate.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i> 
                                    @stat.LastRecordDate.Value.ToString("dd.MM.yyyy")
                                </small>
                            }
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a asp-controller="MedicalRecord" asp-action="Create" 
                               asp-route-categoryId="@stat.CategoryId" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-plus-lg"></i> Добавить
                            </a>
                            <a asp-controller="CategoryRecords" asp-action="Details" 
                               asp-route-id="@stat.CategoryId" 
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye"></i> Смотреть
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Последние записи -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Последние записи</h5>
                <a asp-controller="MedicalRecord" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg"></i> Добавить запись
                </a>
            </div>
            <div class="card-body">
                @if (Model.RecentRecords.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var record in Model.RecentRecords)
                        {
                            <li class="mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@record.Title</strong>
                                        <br>
                                        <small class="text-muted">@record.Category.Name</small>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">@record.RecordDate.ToString("dd.MM.yyyy")</small>
                                        <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary mt-1">
                                            <i class="bi bi-eye"></i> Подробнее
                                        </a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center mb-0">У вас пока нет записей.</p>
                }
            </div>
        </div>
    </div>
</div>