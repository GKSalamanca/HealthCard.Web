@model List<Models.ParameterBase.MedicalRecord>
@{
    var category = ViewBag.Category as Models.ParameterBase.Category;
    var dates = ViewBag.Dates as List<DateOnly>;
    var matrix = ViewBag.Matrix as List<HealthCard.Web.Controllers.ParameterRowViewModel>;
    ViewData["Title"] = category?.Name ?? "Записи";
}

<div class="row mb-4">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item active">@category?.Name</li>
            </ol>
        </nav>
        <h2><i class="bi bi-folder2-open"></i> @category?.Name</h2>
        @if (category?.Description != null)
        {
            <p class="text-muted">@category.Description</p>
        }
    </div>
</div>

@if (category?.IsLabTest == true && matrix != null && matrix.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-table"></i> Динамика показателей</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%">Параметр</th>
                            <th style="width: 10%">Норма</th>
                            <th style="width: 10%">Ед. изм.</th>
                            @foreach (var date in dates)
                            {
                                <th style="width: 11%">@date.ToString("dd.MM.yyyy")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in matrix)
                        {
                            <tr>
                                <td><strong>@row.ParameterName</strong></td>
                                <td><small>@row.NormMin – @row.NormMax</small></td>
                                <td><small>@row.Unit</small></td>
                                @foreach (var date in dates)
                                {
                                    var value = row.Values.ContainsKey(date) ? row.Values[date] : null;
                                    var cellClass = "";
                                    
                                    if (value.HasValue)
                                    {
                                        if (value < row.NormMin || value > row.NormMax)
                                            cellClass = "table-danger";
                                        else if (value <= row.NormMin * 1.1m || value >= row.NormMax * 0.9m)
                                            cellClass = "table-warning";
                                        else
                                            cellClass = "table-success";
                                    }
                                    
                                    <td class="@cellClass">
                                        @if (value.HasValue)
                                        {
                                            <strong>@value</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="mt-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i> 
                    Цветовая индикация: 
                    <span class="badge bg-success">Норма</span>
                    <span class="badge bg-warning text-dark ms-2">Пограничное</span>
                    <span class="badge bg-danger ms-2">Вне нормы</span>
                </small>
            </div>
        </div>
    </div>
}
else
{
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var record in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@record.Title</h5>
                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar"></i> @record.RecordDate.ToString("dd.MM.yyyy")
                            </p>
                            @if (!string.IsNullOrEmpty(record.Comment))
                            {
                                <p class="card-text">@record.Comment</p>
                            }
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <p class="mt-3 text-muted">У вас пока нет записей по этой категории</p>
        </div>
    }
}

<div class="mt-4">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад на главную
    </a>
</div>