@model CategoryRecordsViewModel
@{ViewData["Title"]=Model.Category.Name;}
<div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h1 class="h3">@Model.Category.Name</h1><p class="text-muted mb-0">@Model.Category.Description</p></div><div class="d-flex flex-wrap gap-2 align-self-start"><a asp-controller="MedicalRecord" asp-action="Create" asp-route-categoryId="@Model.Category.Id" class="btn btn-primary">Добавить запись</a>@if(!Model.Category.IsSystem){<a asp-controller="Category" asp-action="Edit" asp-route-id="@Model.Category.Id" class="btn btn-outline-secondary">Изменить категорию</a>}</div></div>
@if(Model.Category.IsLabTest){<div class="d-flex gap-2 mb-3"><a asp-controller="Analytics" asp-action="Index" asp-route-categoryId="@Model.Category.Id" class="btn btn-outline-primary">Аналитика и графики</a><a asp-controller="Norms" asp-action="Index" asp-route-categoryId="@Model.Category.Id" class="btn btn-outline-secondary">Мои нормы</a></div>}
@if(Model.Records.Count==0){<div class="empty-state"><h2 class="h5">В этой категории пока нет записей</h2><p class="text-muted">Добавьте первое исследование, чтобы увидеть историю.</p></div>}
else if(Model.Category.IsLabTest && Model.Parameters.Count>0){<div class="card mb-4"><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><thead><tr><th>Показатель</th><th>Интервал</th><th>Единица</th>@foreach(var r in Model.Records){<th class="text-nowrap"><a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@r.Id" title="@r.Title">@r.RecordDate.ToString("dd.MM.yyyy")<br /><small>Запись №@r.Id</small></a></th>}</tr></thead><tbody>
@foreach(var p in Model.Parameters){var sample=Model.Results.Values.FirstOrDefault(r=>r.ParameterId==p.Id);<tr><th>@p.Name</th><td class="text-nowrap">@((sample?.NormMin??p.NormMin).ToString("0.####")) – @((sample?.NormMax??p.NormMax).ToString("0.####"))</td><td>@p.Unit</td>@foreach(var r in Model.Records){if(Model.Results.TryGetValue((r.Id,p.Id),out var value)){<td class="table-@value.CssClass" title="@value.StatusText"><strong>@value.Value.ToString("0.####")</strong></td>}else{<td class="text-muted">—</td>}}</tr>}
</tbody></table></div></div><p class="small text-muted">Каждая колонка — отдельная запись, в том числе при одинаковой дате. Статусы рассчитаны с учетом персональных интервалов.</p>}
@if(Model.Records.Count>0){<h2 class="h5 mt-4">Все записи категории</h2><div class="list-group mb-4">@foreach(var r in Model.Records.OrderByDescending(r=>r.RecordDate).ThenByDescending(r=>r.Id)){<a class="list-group-item list-group-item-action d-flex justify-content-between gap-3" asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@r.Id"><span>@r.Title</span><span class="text-muted text-nowrap">@r.RecordDate.ToString("dd.MM.yyyy")</span></a>}</div>}
<a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">Все категории</a>
