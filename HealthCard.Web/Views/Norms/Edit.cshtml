@model NormEditViewModel
@{ViewData["Title"]="Настроить интервал";}
<div class="max-form mx-auto"><h1 class="h3">@Model.Name</h1><p class="text-muted">Общий интервал: @Model.DefaultMin.ToString("0.####") – @Model.DefaultMax.ToString("0.####") @Model.Unit</p>
<form method="post" asp-action="Edit" asp-route-id="@Model.TestParameterId" class="card card-body p-4"><input asp-for="TestParameterId" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="NormMin" class="form-label">Моя нижняя граница</label><input asp-for="NormMin" type="number" step="0.0001" min="0" max="99999999" class="form-control" /></div><div class="col-md-6"><label asp-for="NormMax" class="form-label">Моя верхняя граница</label><input asp-for="NormMax" type="number" step="0.0001" min="0" max="99999999" class="form-control" /></div></div><p class="small text-muted mt-3">Укажите референсный интервал из вашего бланка или рекомендации врача. Приложение не рассчитывает медицинские нормы самостоятельно.</p><div class="d-flex gap-2 justify-content-end"><a asp-action="Index" class="btn btn-outline-secondary">Отмена</a><button type="submit" class="btn btn-primary">Сохранить интервал</button></div></form></div>
